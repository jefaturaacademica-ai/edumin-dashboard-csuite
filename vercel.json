{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/cuadro-gigante",
      "destination": "/cuadro-gigante.html"
    },
    {
      "source": "/cohortes",
      "destination": "/cohortes.html"
    },
    {
      "source": "/power-bi",
      "destination": "/power-bi.html"
    },
    {
      "source": "/matriz-mensual",
      "destination": "/matriz-mensual.html"
    },
    {
      "source": "/cartera",
      "destination": "/cartera.html"
    },
    {
      "source": "/promesa-recaudo",
      "destination": "/promesa-recaudo.html"
    },
    {
      "source": "/bi-gerencial",
      "destination": "/bi-gerencial.html"
    },
    {
      "source": "/analitica-avanzada",
      "destination": "/analitica-avanzada.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ]
}